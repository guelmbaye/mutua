    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.24",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
